import React, { useEffect, useState } from 'react';

const UNSPLASH_ACCESS_KEY = 'XFp6L-zULuz0OEIfbsFh9-cowcaMekDMx6VrS-lufSQ';

export default function ImageGallery() {
  const [images, setImages] = useState([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState('');
  const [current, setCurrent] = useState(0);

  useEffect(() => {
    fetchImages();
  }, []);

  async function fetchImages() {
    setLoading(true);
    setError('');
    try {
      const res = await fetch(`https://api.unsplash.com/photos/random?client_id=${UNSPLASH_ACCESS_KEY}&count=7&orientation=landscape`);
      if (!res.ok) throw new Error('Failed to fetch images');
      const data = await res.json();
      setImages(data);
    } catch (err) {
      setError(err.message || 'Unknown error');
    } finally {
      setLoading(false);
    }
  }

  const nextImage = () => {
    if (images.length > 0) setCurrent((c) => (c + 1) % images.length);
  };
  
  const prevImage = () => {
    if (images.length > 0) setCurrent((c) => (c === 0 ? images.length - 1 : c - 1));
  };

  if (loading) return (
    <div className="glass-card p-8 rounded-3xl shadow-xl animate-fadeInUp text-center">
      <div className="animate-pulse flex flex-col items-center">
        <div className="w-full h-64 bg-purple-200/50 rounded-xl mb-4"></div>
        <div className="h-8 bg-purple-200/50 rounded w-1/2 mb-2"></div>
        <div className="h-6 bg-purple-200/50 rounded w-1/3"></div>
      </div>
      <p className="mt-4 text-purple-600">Loading beautiful images...</p>
    </div>
  );
  
  if (error) return (
    <div className="glass-card p-8 rounded-3xl shadow-xl animate-fadeInUp text-center text-red-500">
      <svg className="w-16 h-16 mx-auto" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
      </svg>
      <p className="mt-4">Error: {error}</p>
      <button onClick={fetchImages} className="btn-primary mt-4">Try Again</button>
    </div>
  );
  
  if (!images.length) return (
    <div className="glass-card p-8 rounded-3xl shadow-xl animate-fadeInUp text-center">
      <p>No images found.</p>
      <button onClick={fetchImages} className="btn-primary mt-4">Refresh</button>
    </div>
  );

  return (
    <div className="glass-card p-6 rounded-3xl shadow-xl animate-fadeInUp">
      <h2 className="text-3xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-purple-600 to-indigo-600 mb-6 text-center">Inspirational Gallery</h2>
      
      <div className="relative w-full h-[400px] rounded-2xl overflow-hidden shadow-lg mb-6">
        <img
          src={images[current].urls.regular}
          alt={images[current].alt_description || 'Inspirational'}
          className="w-full h-full object-cover transition-all duration-500 hover:scale-105"
        />
        
        <div className="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent flex items-end">
          <div className="p-6 text-white">
            <h3 className="text-xl font-bold">{images[current].user.name}</h3>
            <p className="text-sm opacity-80">
              {images[current].description || images[current].alt_description || 'Beautiful inspirational image'}
            </p>
          </div>
        </div>
        
        <button 
          onClick={prevImage} 
          className="absolute left-4 top-1/2 -translate-y-1/2 bg-white/20 backdrop-blur-sm text-white rounded-full p-3 hover:bg-white/40 transition-all duration-300"
          aria-label="Previous image"
        >
          <svg xmlns="http://www.w3.org/2000/svg" className="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M15 19l-7-7 7-7" />
          </svg>
        </button>
        
        <button 
          onClick={nextImage} 
          className="absolute right-4 top-1/2 -translate-y-1/2 bg-white/20 backdrop-blur-sm text-white rounded-full p-3 hover:bg-white/40 transition-all duration-300"
          aria-label="Next image"
        >
          <svg xmlns="http://www.w3.org/2000/svg" className="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M9 5l7 7-7 7" />
          </svg>
        </button>
      </div>
      
      <div className="flex justify-center gap-2 mb-4">
        {images.map((_, i) => (
          <button
            key={i}
            className={`w-3 h-3 rounded-full transition-all duration-300 ${
              i === current ? 'bg-purple-600 scale-125' : 'bg-purple-200'
            }`}
            onClick={() => setCurrent(i)}
            aria-label={`Go to image ${i + 1}`}
          />
        ))}
      </div>
      
      <div className="flex justify-center gap-4">
        <button onClick={fetchImages} className="btn-primary">
          New Images
        </button>
        <button onClick={nextImage} className="btn-secondary">
          Next Image
        </button>
      </div>
    </div>
  );
}
