import React, { useEffect, useState } from 'react';
import { useDispatch, useSelector } from 'react-redux';
import { fetchWeather } from '../redux/reducers';

const Weather = () => {
  const dispatch = useDispatch();
  const weather = useSelector((state) => state.app.weather);
  const [city, setCity] = useState('New York');

  useEffect(() => {
    dispatch(fetchWeather(city)); // Default city
  }, [dispatch]);

  const handleCityChange = (e) => {
    setCity(e.target.value);
  };

  const handleSubmit = (e) => {
    e.preventDefault();
    if (city.trim()) {
      dispatch(fetchWeather(city));
    }
  };

  return (
    <div className="glass-card p-6 rounded-3xl shadow-xl animate-fadeInUp">
      <h2 className="text-2xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-purple-600 to-indigo-600 mb-4">Weather</h2>
      
      <form onSubmit={handleSubmit} className="mb-4 flex gap-2">
        <input
          type="text"
          value={city}
          onChange={handleCityChange}
          placeholder="Enter city name"
          className="input-primary flex-1"
        />
        <button type="submit" className="btn-primary">
          <svg xmlns="http://www.w3.org/2000/svg" className="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
            <path fillRule="evenodd" d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z" clipRule="evenodd" />
          </svg>
        </button>
      </form>

      {weather.status === 'loading' && (
        <div className="text-center py-8">
          <div className="animate-pulse text-purple-600">
            <svg className="w-12 h-12 mx-auto" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z" />
            </svg>
            <p className="mt-2">Loading weather data...</p>
          </div>
        </div>
      )}

      {weather.status === 'failed' && (
        <div className="text-center py-6 text-red-500">
          <svg className="w-12 h-12 mx-auto" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
          </svg>
          <p className="mt-2">Error fetching weather data</p>
        </div>
      )}

      {weather.status === 'succeeded' && weather.data && (
        <div className="text-center">
          <div className="flex items-center justify-center gap-4">
            <div>
              <h3 className="text-3xl font-bold text-purple-700">{weather.data.name}</h3>
              <p className="text-5xl font-light text-gray-800 my-2">{Math.round(weather.data.main.temp - 273.15)}°C</p>
              <p className="text-gray-600 capitalize">{weather.data.weather[0].description}</p>
            </div>
            <div className="bg-gradient-to-br from-blue-400 to-purple-500 rounded-full p-3">
              <svg className="w-16 h-16 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z" />
              </svg>
            </div>
          </div>
          <div className="grid grid-cols-3 gap-2 mt-4 text-center">
            <div className="bg-white/50 p-2 rounded-lg">
              <p className="text-gray-500 text-xs">Humidity</p>
              <p className="font-bold text-gray-700">{weather.data.main.humidity}%</p>
            </div>
            <div className="bg-white/50 p-2 rounded-lg">
              <p className="text-gray-500 text-xs">Wind</p>
              <p className="font-bold text-gray-700">{weather.data.wind.speed} m/s</p>
            </div>
            <div className="bg-white/50 p-2 rounded-lg">
              <p className="text-gray-500 text-xs">Feels Like</p>
              <p className="font-bold text-gray-700">{Math.round(weather.data.main.feels_like - 273.15)}°C</p>
            </div>
          </div>
        </div>
      )}
    </div>
  );
};

export default Weather;
